# Safe to expose in browser code. Find these in the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this variable with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Server-only AI analysis provider.
OPENAI_API_KEY=sk-your_openai_key
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# Development only. Set to true to show seeded UI data when Supabase is empty or unavailable.
ENABLE_DEVELOPMENT_MOCK_FALLBACK=false
