# Safe to expose in browser code. Find these in the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this variable with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key
